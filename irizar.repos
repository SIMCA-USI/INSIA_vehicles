# Repositorios que necesita el vehiculo irizar. Se descargan con:
#   cd ~/ros2_ws/src && vcs import < insia_irizar/irizar.repos
repositories:
  INSIA_control:
    type: git
    url: https://github.com/SIMCA-USI/INSIA_control.git
    version: develop
  insia_msg:
    type: git
    url: https://github.com/SIMCA-USI/INSIA_msg.git
    version: master
  ros2socketcan_bridge:
    type: git
    url: https://github.com/SIMCA-USI/ros2socketcan_bridge.git
    version: master
