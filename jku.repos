# Repositorios que necesita el vehiculo jku. Se descargan con:
#   cd ~/ros2_ws/src && vcs import < insia_jku/jku.repos
repositories:
  INSIA_control:
    type: git
    url: https://github.com/SIMCA-USI/INSIA_control.git
    version: develop
  insia_msg:
    type: git
    url: https://github.com/SIMCA-USI/INSIA_msg.git
    version: master
